<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>

<fx:root type="javafx.scene.layout.HBox"
         xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml">

    <Region minWidth="14" prefWidth="14" maxWidth="14"/>

    <VBox spacing="20" minWidth="-Infinity" maxWidth="-Infinity" styleClass="semi-transparent-bg">

        <Label text="COLORS LEGEND"
               maxWidth="Infinity"
               alignment="CENTER"
               styleClass="legend-header-lbl"/>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Task not started" styleClass="legend-item-lbl"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Rectangle height="20" width="20" styleClass="legend-rect-tostart"/>
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Task started" styleClass="legend-item-lbl"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Rectangle height="20" width="20" styleClass="legend-rect-started"/>
        </HBox>

        <HBox spacing="12" alignment="CENTER_LEFT">
            <Label text="Task done" styleClass="legend-item-lbl"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Rectangle height="20" width="20" styleClass="legend-rect-done"/>
        </HBox>

        <Region prefHeight="2" maxWidth="Infinity" styleClass="legend-separator"/>

        <Label text="ACTIVE TASKS"
               maxWidth="Infinity"
               alignment="CENTER"
               styleClass="legend-header-lbl"/>

        <ScrollPane fitToWidth="true"
                    VBox.vgrow="ALWAYS"
                    styleClass="transparent-scroll">
            <VBox fx:id="activeTaskContainer"
                  spacing="8"
                  styleClass="transparent-vbox"/>
        </ScrollPane>

        <VBox>
            <Region prefHeight="2" maxWidth="Infinity" styleClass="legend-separator"/>
            <Button fx:id="toggleMainWindowButton"
                    text="OPEN DASHBOARD"
                    styleClass="styled-btn"
                    maxWidth="Infinity"/>
        </VBox>

        <VBox spacing="0">
            <Region prefHeight="2" maxWidth="Infinity" styleClass="legend-separator"/>
            <Button fx:id="createTaskButton"
                    text="CREATE TASK"
                    styleClass="styled-btn"
                    maxWidth="Infinity"/>
        </VBox>

        <VBox fx:id="chatActionsContainer" maxWidth="Infinity">
            <Region prefHeight="2" maxWidth="Infinity" styleClass="legend-separator"/>
            <Button fx:id="chatButton"
                    text="OPEN CHAT"
                    styleClass="styled-btn"
                    maxWidth="Infinity"/>
            <Region prefHeight="2" maxWidth="Infinity" styleClass="legend-separator"/>
        </VBox>

        <VBox spacing="0">
            <Button fx:id="logOutButton"
                    text="LOG OUT"
                    styleClass="styled-btn-red"
                    maxWidth="Infinity"/>
        </VBox>

    </VBox>
</fx:root>
