<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>

<fx:root type="javafx.scene.layout.BorderPane"
         xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml">

    <padding>
        <Insets top="10" right="14" bottom="10" left="14"/>
    </padding>

    <center>
        <HBox fx:id="centerContainer" spacing="20" alignment="CENTER_LEFT">

            <!-- TO BE STARTED COLUMN -->
            <VBox spacing="4" HBox.hgrow="NEVER">
                <VBox.margin>
                    <Insets right="6"/>
                </VBox.margin>
                <ScrollPane fitToWidth="true"
                            VBox.vgrow="ALWAYS"
                            styleClass="transparent-scroll">
                    <VBox fx:id="notStartedTaskBox"
                          minHeight="280"
                          prefWidth="350"
                          spacing="14"
                          styleClass="semi-transparent-bg">
                        <padding>
                            <Insets top="12" right="12" bottom="12" left="12"/>
                        </padding>
                        <Label text="TO BE STARTED" styleClass="task-column-header,to-start"/>
                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- STARTED COLUMN -->
            <VBox spacing="4" HBox.hgrow="NEVER">
                <VBox.margin>
                    <Insets right="6"/>
                </VBox.margin>
                <ScrollPane fitToWidth="true"
                            VBox.vgrow="ALWAYS"
                            styleClass="transparent-scroll">
                    <VBox fx:id="startedTaskBox"
                          minHeight="280"
                          prefWidth="350"
                          spacing="14"
                          styleClass="semi-transparent-bg">
                        <padding>
                            <Insets top="12" right="12" bottom="12" left="12"/>
                        </padding>
                        <Label text="IN PROGRESS" styleClass="task-column-header,started"/>
                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- DONE COLUMN -->
            <VBox spacing="4" HBox.hgrow="NEVER">
                <VBox.margin>
                    <Insets right="6"/>
                </VBox.margin>
                <ScrollPane fitToWidth="true"
                            VBox.vgrow="ALWAYS"
                            styleClass="transparent-scroll">
                    <VBox fx:id="doneTaskBox"
                          minHeight="280"
                          prefWidth="350"
                          spacing="14"
                          styleClass="semi-transparent-bg">
                        <padding>
                            <Insets top="12" right="12" bottom="12" left="12"/>
                        </padding>
                        <Label text="COMPLETED" styleClass="task-column-header,done"/>
                    </VBox>
                </ScrollPane>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

        </HBox>
    </center>


</fx:root>