<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ScrollPane?>

<fx:root type="javafx.scene.layout.BorderPane"
         xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml">

    <padding>
        <Insets top="10" right="14" bottom="10" left="14"/>
    </padding>

    <center>
        <HBox fx:id="centerContainer" spacing="20" alignment="CENTER_LEFT">

            <!-- TO BE STARTED COLUMN -->
            <VBox spacing="4" HBox.hgrow="NEVER">
                <VBox.margin>
                    <Insets right="6"/>
                </VBox.margin>
                <ScrollPane fitToWidth="true"
                            VBox.vgrow="ALWAYS"
                            styleClass="transparent-scroll">
                    <VBox fx:id="notStartedTaskBox"
                          minHeight="280"
                          prefWidth="350"
                          spacing="14"
                          styleClass="semi-transparent-bg">
                        <padding>
                            <Insets top="12" right="12" bottom="12" left="12"/>
                        </padding>
                        <Label text="TO BE STARTED" styleClass="task-column-header,to-start"/>
                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- STARTED COLUMN -->
            <VBox spacing="4" HBox.hgrow="NEVER">
                <VBox.margin>
                    <Insets right="6"/>
                </VBox.margin>
                <ScrollPane fitToWidth="true"
                            VBox.vgrow="ALWAYS"
                            styleClass="transparent-scroll">
                    <VBox fx:id="startedTaskBox"
                          minHeight="280"
                          prefWidth="350"
                          spacing="14"
                          styleClass="semi-transparent-bg">
                        <padding>
                            <Insets top="12" right="12" bottom="12" left="12"/>
                        </padding>
                        <Label text="IN PROGRESS" styleClass="task-column-header,started"/>
                    </VBox>
                </ScrollPane>
            </VBox>

            <!-- DONE COLUMN -->
            <VBox spacing="4" HBox.hgrow="NEVER">
                <VBox.margin>
                    <Insets right="6"/>
                </VBox.margin>
                <ScrollPane fitToWidth="true"
                            VBox.vgrow="ALWAYS"
                            styleClass="transparent-scroll">
                    <VBox fx:id="doneTaskBox"
                          minHeight="280"
                          prefWidth="350"
                          spacing="14"
                          styleClass="semi-transparent-bg">
                        <padding>
                            <Insets top="12" right="12" bottom="12" left="12"/>
                        </padding>
                        <Label text="COMPLETED" styleClass="task-column-header,done"/>
                    </VBox>
                </ScrollPane>
            </VBox>

            <Region HBox.hgrow="ALWAYS"/>

        </HBox>
    </center>

    <right>
        <HBox>
            <Region minWidth="14" prefWidth="14" maxWidth="14"/>
            <VBox spacing="20" minWidth="240" prefWidth="240" maxWidth="240"
                  styleClass="semi-transparent-bg">

                <Label text="COLORS LEGEND"
                       maxWidth="Infinity"
                       alignment="CENTER"
                       styleClass="legend-header-lbl"/>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Task not started" styleClass="legend-item-lbl"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Rectangle height="20" width="20" styleClass="legend-rect-tostart"/>
                </HBox>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Task started" styleClass="legend-item-lbl"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Rectangle height="20" width="20" styleClass="legend-rect-started"/>
                </HBox>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Label text="Task done" styleClass="legend-item-lbl"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Rectangle height="20" width="20" styleClass="legend-rect-done"/>
                </HBox>

                <Region prefHeight="2" maxWidth="Infinity" styleClass="legend-separator"/>

                <Label text="ACTIVE TASKS"
                       maxWidth="Infinity"
                       alignment="CENTER"
                       styleClass="legend-header-lbl"/>

                <ScrollPane fitToWidth="true"
                            VBox.vgrow="ALWAYS"
                            styleClass="transparent-scroll">
                    <VBox fx:id="activeTaskContainer"
                          spacing="8"
                          styleClass="transparent-vbox"/>
                </ScrollPane>

                <Region prefHeight="2" maxWidth="Infinity" styleClass="legend-separator"/>

                <Button fx:id="openDashboardButton"
                        text="OPEN DASHBOARD"
                        styleClass="styled-btn"
                        maxWidth="Infinity"/>

                <Region prefHeight="2" maxWidth="Infinity" styleClass="legend-separator"/>

                <Button fx:id="createTaskButton"
                        text="CREATE TASK"
                        styleClass="styled-btn"
                        maxWidth="Infinity"/>

                <Region prefHeight="2" maxWidth="Infinity" styleClass="legend-separator"/>

                <Button fx:id="chatButton"
                        text="OPEN CHAT"
                        styleClass="styled-btn"
                        maxWidth="Infinity"/>

                <Region prefHeight="2" maxWidth="Infinity" styleClass="legend-separator"/>

                <Button fx:id="logOutButton"
                        text="LOG OUT"
                        styleClass="styled-btn-red"
                        maxWidth="Infinity"/>

            </VBox>
        </HBox>
    </right>

</fx:root>