<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<fx:root type="BorderPane"
         xmlns="http://javafx.com/javafx/21"
         xmlns:fx="http://javafx.com/fxml/1"
         maxWidth="Infinity"
         minHeight="-Infinity"
         maxHeight="Infinity">

    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <center>
        <VBox spacing="10" maxWidth="Infinity">

            <Label fx:id="titleLabel"
                   styleClass="task-description-lbl-compact"
                   wrapText="true"
                   textOverrun="CLIP"
                   maxWidth="Infinity"/>

            <Label fx:id="stateLabel"
                   styleClass="task-state-lbl-compact"
                   wrapText="true"
                   textOverrun="CLIP"
                   maxWidth="Infinity"
                   alignment="CENTER"
                   textAlignment="CENTER"
                   text="TO BE STARTED"/>

            <HBox spacing="8" maxWidth="Infinity">
                <Button fx:id="changeStateButton"
                        styleClass="styled-btn-compact"
                        text="START"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="deleteButton"
                        styleClass="styled-btn-red-compact"
                        text="DELETE"/>
            </HBox>

        </VBox>
    </center>
</fx:root>