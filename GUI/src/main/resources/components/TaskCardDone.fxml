<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.RowConstraints?>
<fx:root type="BorderPane"
         xmlns="http://javafx.com/javafx/21"
         xmlns:fx="http://javafx.com/fxml/1"
         maxWidth="Infinity"
         minHeight="-Infinity"
         maxHeight="Infinity">

    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>

    <top>
        <Label fx:id="dateLabel"
               styleClass="task-date-lbl-compact"
               wrapText="true"
               textOverrun="CLIP"
               maxWidth="Infinity"
               BorderPane.alignment="CENTER"
               textAlignment="CENTER">
            <BorderPane.margin>
                <Insets bottom="10"/>
            </BorderPane.margin>
        </Label>
    </top>

    <center>
        <VBox spacing="10" maxWidth="Infinity">

            <Label fx:id="titleLabel"
                   styleClass="task-description-lbl-compact"
                   wrapText="true"
                   textOverrun="CLIP"
                   maxWidth="Infinity">
                <VBox.margin>
                    <Insets top="10" bottom="10"/>
                </VBox.margin>
            </Label>

            <Label fx:id="stateLabel"
                   styleClass="task-state-lbl-compact"
                   wrapText="true"
                   textOverrun="CLIP"
                   maxWidth="Infinity"
                   alignment="CENTER"
                   textAlignment="CENTER"
                   text="COMPLETED"/>

            <GridPane fx:id="workersGrid"
                      hgap="8" vgap="8"
                      maxWidth="Infinity">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50"/>
                    <ColumnConstraints percentWidth="50"/>
                </columnConstraints>
                <rowConstraints>
                    <RowConstraints/>
                </rowConstraints>
            </GridPane>

            <HBox fx:id="bottomButtonBox" spacing="8" maxWidth="Infinity">
                <Button fx:id="resetButton"
                        text="RESET"
                        styleClass="styled-btn-compact"/>
                <Region HBox.hgrow="ALWAYS"/>
            </HBox>

        </VBox>
    </center>
</fx:root>