<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<fx:root type="StackPane"
         xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml"
         prefWidth="400"
         maxWidth="400"
         styleClass="semi-transparent-bg">

    <VBox spacing="15"
          prefWidth="400"
          maxWidth="400">
        <padding>
            <Insets top="15" right="15" bottom="15" left="15"/>
        </padding>
        <VBox fx:id="closedChatArea">

            <!-- ========================= -->
            <!-- AVAILABLE CHATS -->
            <!-- ========================= -->

            <Label text="Available Chats"
                   styleClass="section-title"/>

            <ScrollPane fitToWidth="true"
                        prefHeight="220"
                        styleClass="transparent-scroll">

                <VBox fx:id="chats"
                      spacing="8"
                      prefWidth="380"
                      styleClass="chat-list"/>
            </ScrollPane>

            <!-- ========================= -->
            <!-- NEW CHAT -->
            <!-- ========================= -->

            <Separator/>

            <Label text="Start a New Chat"
                   styleClass="section-title"/>

            <ScrollPane fitToWidth="true"
                        prefHeight="180"
                        styleClass="transparent-scroll">

                <VBox fx:id="unmatchedEmployeeContainer"
                      spacing="8"/>

            </ScrollPane>
        </VBox>

        <!-- ========================= -->
        <!-- CHAT AREA -->
        <!-- ========================= -->

        <VBox fx:id="chatArea"
              spacing="10"
              visible="false"
              managed="false"
              VBox.vgrow="ALWAYS">

            <Button fx:id="backButton"
                    text="← Back"
                    styleClass="styled-btn-compact"
                    maxWidth="Infinity"/>

            <ScrollPane fx:id="scrollPane"
                        fitToWidth="true"
                        VBox.vgrow="ALWAYS"
                        styleClass="transparent-scroll">

                <VBox fx:id="chatContainer"
                      spacing="10"/>

            </ScrollPane>

            <HBox spacing="8">

                <TextField fx:id="inputForm"
                           promptText="Type a message..."
                           HBox.hgrow="ALWAYS"
                           styleClass="form-input"/>

                <Button fx:id="sendButton"
                        text="Send"
                        styleClass="styled-btn-compact"/>

            </HBox>

        </VBox>

    </VBox>

</fx:root>