<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.shape.*?>

<fx:root type="BorderPane"
         xmlns="http://javafx.com/javafx/21"
         xmlns:fx="http://javafx.com/fxml/1">

    <center>
        <ScrollPane
                fitToWidth="true"
                hbarPolicy="NEVER"
                styleClass="transparent-scroll"
                prefHeight="500"
                maxHeight="980">

            <StackPane>

                <VBox
                        alignment="CENTER"
                        spacing="10"
                        maxWidth="550"
                        minHeight="430"
                        styleClass="semi-transparent-bg">

                    <!-- CLOSE -->
                    <HBox fx:id="header" >
                    </HBox>

                    <HBox alignment="CENTER">
                        <Label text="FILL IN TASK DETAILS"
                               styleClass="insert-text-lbl"/>
                    </HBox>

                    <TextField fx:id="descriptionField"
                               promptText="Enter the task description"
                               styleClass="input-form"
                               prefHeight="45"/>

                    <!-- START -->
                    <HBox fx:id="startDateContainer" spacing="10">
                        <VBox>
                            <Label text="START DATE" styleClass="info-text-lbl"/>
                            <Pane fx:id="startPickerContainer"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Pane fx:id="startTimeBox"/>
                    </HBox>

                    <!-- END -->
                    <HBox fx:id="endDateContainer" spacing="10">
                        <VBox>
                            <Label text="END DATE" styleClass="info-text-lbl"/>
                            <Pane fx:id="endPickerContainer"/>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Pane fx:id="endTimeBox"/>
                    </HBox>

                    <HBox alignment="CENTER">
                        <Button fx:id="submitButton"
                                text="SUBMIT"
                                styleClass="styled-btn"
                                prefWidth="200"
                                prefHeight="45"/>
                    </HBox>

                </VBox>

            </StackPane>

        </ScrollPane>
    </center>

</fx:root>