<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Label?>

<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.control.Separator?>
<fx:root type="javafx.scene.layout.BorderPane"
         xmlns="http://javafx.com/javafx"
         xmlns:fx="http://javafx.com/fxml">

    <padding>
        <Insets top="10" right="14" bottom="10" left="14"/>
    </padding>

    <center>
        <VBox>
            <HBox alignment="CENTER_LEFT"  styleClass="semi-transparent-bg" maxWidth="-Infinity">
                <BorderPane  fx:id="workerAvatarContainer"/>
                <Region minWidth="30"/>
                <Label  fx:id="workerNameLabel" styleClass="dashboard-user-info-label"/>
                <Region minWidth="10"/>
                <Label   fx:id="workerSurnameLabel" styleClass="dashboard-user-info-label"/>
                <Region minWidth="5"/>
                <Separator orientation="VERTICAL" styleClass="white-separator"/>
                <Region minWidth="5"/>
                <Label fx:id="workerEmailLabel" styleClass="dashboard-user-info-label"/>
            </HBox>
        </VBox>
    </center>


</fx:root>