<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.shape.Rectangle?>
<?import javafx.scene.layout.Region?>

<fx:root type="BorderPane"
         xmlns="http://javafx.com/javafx/21"
         xmlns:fx="http://javafx.com/fxml/1">

    <padding>
        <Insets top="12" right="12" bottom="12" left="12"/>
    </padding>


    <top>

        <Rectangle fx:id="dateSkeleton"
                   width="120"
                   height="18"
                   arcWidth="8"
                   arcHeight="8"/>

    </top>


    <center>

        <VBox spacing="10">

            <Rectangle fx:id="titleSkeleton"
                       width="250"
                       height="25"
                       arcWidth="8"
                       arcHeight="8"/>


            <Rectangle fx:id="stateSkeleton"
                       width="100"
                       height="20"
                       arcWidth="8"
                       arcHeight="8"/>


            <VBox fx:id="workersSkeleton"
                  spacing="8">

            </VBox>


            <HBox spacing="8">

                <Rectangle width="80"
                           height="30"
                           arcWidth="8"
                           arcHeight="8"/>


                <Region HBox.hgrow="ALWAYS"/>


                <Rectangle width="80"
                           height="30"
                           arcWidth="8"
                           arcHeight="8"/>

            </HBox>

        </VBox>

    </center>

</fx:root>